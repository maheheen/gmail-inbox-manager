        "categories": {
          "categories": [
            {
              "category": "Service Requests",
              "description": "Emails from existing clients asking for support, changes, revisions, or reporting an issue with work that is already in progress. Only for people with an active or prior working relationship — not new inquiries."
            },
            {
              "category": "Consultation Requests",
              "description": "Emails from new or prospective clients asking about services, requesting a call/meeting, or asking for a quote or proposal. From someone with no existing active work — if they already have a project running, use Service Requests instead."
            },
            {
              "category": "Payments",
              "description": "=Invoices, payment confirmations, receipts, billing questions, or payment reminders. From clients, payment processors (Stripe, PayPal), or banks."
            },
            {
              "category": "Jobs/Applications",
              "description": "Replies to job, internship, or externship applications you submitted — interview invites, assessments, rejections, or status updates. Not general networking or unsolicited outreach from others."
            },
            {
              "category": "Networking/Oppurtunities",
              "description": "Pitches, collaboration or guest post invites, speaking or interview requests from others, and networking outreach. Not replies to jobs/internships you applied for — those go to Jobs / Applications. Not a request for paid services — those go to Consultation or Service Requests."
            },
            {
              "category": "Others",
              "description": "Newsletters, promotions, spam, internal/team mail, or anything that doesn't clearly match the categories above."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Please classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json."
